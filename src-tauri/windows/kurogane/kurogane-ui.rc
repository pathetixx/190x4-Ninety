// Custom NSIS dialog geometry for Ninety — Kurogane Split.
// Based on the NSIS Modern UI resource contract (zlib/libpng license).
// All IDs required by the NSIS exehead are preserved; Ninety controls use 1200+.

#include <windows.h>
#include <richedit.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Main frame: left brand atelier + right page host. 560×360 DLU produces a
// roughly 920×590 px window at 100% scaling with Segoe UI 9.
IDD_INST DIALOGEX 0, 0, 560, 360
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    CONTROL         "",IDC_K_LEFT_ART,"Static",SS_BITMAP | SS_CENTERIMAGE | WS_GROUP,0,44,220,285
    CONTROL         "",IDC_CHILDRECT,"Static",SS_BLACKRECT | NOT WS_VISIBLE | WS_GROUP,220,44,340,285
    CONTROL         "",1044,"Static",SS_BLACKRECT | NOT WS_VISIBLE | WS_GROUP,220,44,340,285

    CONTROL         "",IDC_K_TOP_BACKGROUND,"Static",SS_BLACKRECT | WS_GROUP,0,0,560,44
    CONTROL         "",IDC_K_TOP_SEPARATOR,"Static",SS_ETCHEDHORZ | WS_GROUP,0,43,560,1
    CONTROL         "",IDC_K_FOOTER_BACKGROUND,"Static",SS_BLACKRECT | WS_GROUP,0,329,560,31
    CONTROL         "",IDC_K_FOOTER_SEPARATOR,"Static",SS_ETCHEDHORZ | WS_GROUP,0,328,560,1

    CONTROL         "",IDC_K_TITLE_MARK,"Static",SS_BITMAP | SS_CENTERIMAGE | WS_GROUP,10,5,150,34
    LTEXT           "",IDC_K_WORDMARK,600,0,1,1,NOT WS_VISIBLE
    LTEXT           "",IDC_K_SUBMARK,600,0,1,1,NOT WS_VISIBLE
    CTEXT           "",IDC_K_VERSION,245,15,70,12,SS_NOPREFIX
    CONTROL         "_",IDC_K_MINIMIZE,"Static",SS_CENTER | SS_CENTERIMAGE | SS_NOTIFY,501,10,24,18
    CONTROL         "X",IDC_K_CLOSE,"Static",SS_CENTER | SS_CENTERIMAGE | SS_NOTIFY,531,10,24,18

    // Keep mandatory MUI header controls outside the visible composition.
    LTEXT           "",1037,600,0,1,1,NOT WS_VISIBLE
    LTEXT           "",1038,600,0,1,1,NOT WS_VISIBLE
    ICON            103,1039,600,0,1,1,NOT WS_VISIBLE
    LTEXT           "",1256,600,0,1,1,NOT WS_VISIBLE
    LTEXT           "",IDC_VERSTR,600,0,1,1,NOT WS_VISIBLE | WS_DISABLED
    CONTROL         "",IDC_LICENSEAGREE,"Static",NOT WS_VISIBLE,600,0,1,1
    CONTROL         "",IDC_LICENSEDISAGREE,"Static",NOT WS_VISIBLE,600,0,1,1
    CONTROL         "",1036,"Static",NOT WS_VISIBLE,600,0,1,1
    CONTROL         "",1045,"Static",NOT WS_VISIBLE,600,0,1,1

    // NSIS continues to own these buttons and all page navigation. They stay
    // off-canvas; the dark static controls below mirror and click them.
    PUSHBUTTON      "",IDC_BACK,600,336,58,18,BS_FLAT | WS_GROUP
    PUSHBUTTON      "",IDOK,663,336,66,18,BS_FLAT
    PUSHBUTTON      "",IDCANCEL,734,336,61,18,BS_FLAT
    CONTROL         "",IDC_K_NAV_BACK,"Static",SS_CENTER | SS_CENTERIMAGE | SS_NOTIFY,360,336,58,18
    CONTROL         "",IDC_K_NAV_NEXT,"Static",SS_CENTER | SS_CENTERIMAGE | SS_NOTIFY,423,336,66,18
    CONTROL         "",IDC_K_NAV_CANCEL,"Static",SS_CENTER | SS_CENTERIMAGE | SS_NOTIFY,494,336,61,18
END

// License — the rich text remains selectable and keyboard accessible.
IDD_LICENSE DIALOGEX 0, 0, 340, 285
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "",1040,22,18,296,18,NOT WS_GROUP
    CONTROL         "",IDC_EDIT1,RICHEDIT_CLASS,WS_BORDER | WS_VSCROLL | WS_TABSTOP | ES_READONLY | ES_MULTILINE,22,44,296,174
    LTEXT           "",IDC_INTROTEXT,22,228,296,36,NOT WS_GROUP
END

IDD_LICENSE_FSRB DIALOGEX 0, 0, 340, 285
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "",1040,22,14,296,18,NOT WS_GROUP
    CONTROL         "",IDC_EDIT1,RICHEDIT_CLASS,WS_BORDER | WS_VSCROLL | WS_TABSTOP | ES_READONLY | ES_MULTILINE,22,38,296,162
    LTEXT           "",IDC_INTROTEXT,22,208,296,28,NOT WS_GROUP
    CONTROL         "",IDC_LICENSEAGREE,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,22,240,296,10
    CONTROL         "",IDC_LICENSEDISAGREE,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,22,258,296,10
END

IDD_LICENSE_FSCB DIALOGEX 0, 0, 340, 285
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "",1040,22,14,296,18,NOT WS_GROUP
    CONTROL         "",IDC_EDIT1,RICHEDIT_CLASS,WS_BORDER | WS_VSCROLL | WS_TABSTOP | ES_READONLY | ES_MULTILINE,22,38,296,174
    LTEXT           "",IDC_INTROTEXT,22,220,296,28,NOT WS_GROUP
    CONTROL         "",IDC_LICENSEAGREE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,254,296,10
END

IDD_DIR DIALOGEX 0, 0, 340, 285
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "",IDC_INTROTEXT,22,24,296,68,NOT WS_GROUP
    GROUPBOX        "",IDC_SELDIRTEXT,22,112,296,52
    EDITTEXT        IDC_DIR,32,132,211,16,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDC_BROWSE,249,130,59,19,BS_FLAT
    CONTROL         "",IDC_SPACEREQUIRED,"Static",SS_LEFTNOWORDWRAP,22,188,145,10
    CONTROL         "",IDC_SPACEAVAILABLE,"Static",SS_LEFTNOWORDWRAP,173,188,145,10
    CONTROL         "",IDC_CHECK1,"Button",BS_AUTOCHECKBOX | NOT WS_VISIBLE | WS_TABSTOP,190,218,128,12
END

IDD_SELCOM DIALOGEX 0, 0, 340, 285
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "",IDC_INTROTEXT,22,18,296,35,NOT WS_GROUP
    LTEXT           "",IDC_TEXT1,22,62,104,10
    COMBOBOX        IDC_COMBO1,132,59,186,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_TREE1,"SysTreeView32",TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_DISABLEDRAGDROP | WS_BORDER | WS_TABSTOP,22,86,296,126
    LTEXT           "",IDC_TEXT2,22,220,296,28,NOT WS_GROUP
    LTEXT           "",IDC_SPACEREQUIRED,22,258,296,12,NOT WS_GROUP
END

// Real NSIS progress page. IDC_PROGRESS is the native progress control that the
// installer engine updates; Ninety only skins and mirrors its percentage.
IDD_INSTFILES DIALOGEX 0, 0, 340, 285
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "",IDC_K_STEP_OPTIONS,24,28,84,12,SS_CENTER | SS_NOPREFIX
    LTEXT           "",IDC_K_STEP_INSTALL,128,28,84,12,SS_CENTER | SS_NOPREFIX
    LTEXT           "",IDC_K_STEP_DONE,232,28,84,12,SS_CENTER | SS_NOPREFIX

    LTEXT           "",IDC_K_PAGE_TITLE,25,79,290,28,SS_NOPREFIX
    LTEXT           "",IDC_K_PAGE_SUBTITLE,25,112,290,28,SS_NOPREFIX

    CONTROL         "",IDC_K_PROGRESS_FRAME,"Static",SS_BITMAP | SS_CENTERIMAGE | WS_GROUP,24,170,264,28
    CONTROL         "",IDC_PROGRESS,"msctls_progress32",PBS_SMOOTH,34,180,244,8
    RTEXT           "0%",IDC_K_PERCENT,290,177,30,14,SS_NOPREFIX
    LTEXT           "●",IDC_K_STATUS_DOT,25,216,14,14,SS_NOPREFIX
    LTEXT           "",IDC_K_STATUS,43,216,270,22,SS_NOPREFIX

    CONTROL         "",IDC_INTROTEXT,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | NOT WS_VISIBLE,0,0,1,1
    PUSHBUTTON      "",IDC_SHOWDETAILS,25,252,86,17,BS_FLAT | NOT WS_TABSTOP
    CONTROL         "",IDC_LIST1,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | NOT WS_VISIBLE | WS_BORDER | WS_TABSTOP,24,46,292,218
END

IDD_UNINST DIALOGEX 0, 0, 340, 285
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "",IDC_INTROTEXT,24,55,292,70,NOT WS_GROUP
    LTEXT           "",IDC_UNINSTFROM,24,150,80,12,NOT WS_GROUP
    EDITTEXT        IDC_EDIT1,24,169,292,18,ES_AUTOHSCROLL | ES_READONLY
END

IDD_VERIFY DIALOGEX 0, 0, 260, 68
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    CTEXT           "",IDC_STR,20,39,220,12,NOT WS_GROUP
    CTEXT           "Ninety Setup",IDC_K_VERIFY_TEXT,20,15,220,16,NOT WS_GROUP
END
