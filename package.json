{
  "name": "ninety",
  "private": true,
  "version": "0.6.0",
  "description": "Ninety — Windows desktop networking client for sing-box, WARP and routing rules",
  "license": "MIT",
  "homepage": "https://pathetixx.github.io/190x4-Ninety/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathetixx/190x4-Ninety.git"
  },
  "bugs": {
    "url": "https://github.com/pathetixx/190x4-Ninety/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "tauri": "tauri",
    "preflight": "node scripts/preflight.mjs",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "check:versions": "node scripts/check-version.mjs",
    "check:installer": "node scripts/check-installer.mjs",
    "check:installer-compile": "python3 scripts/nsis_compile_check.py",
    "check:actions-pinned": "node scripts/check-actions-pinned.mjs",
    "check:privileged-paths": "node scripts/check-privileged-paths.mjs",
    "check:dpi-key-rotation": "node scripts/check-dpi-key-rotation.mjs",
    "lint": "eslint --max-warnings 0 src site tests scripts",
    "preinstall": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "eslint": "10.9.1",
    "globals": "17.11.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.0.1",
    "@tauri-apps/plugin-process": "^2.0.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@tauri-apps/plugin-updater": "^2.0.1"
  }
}
