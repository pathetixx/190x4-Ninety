# Тестовый профиль для scripts/emit-sample-configs.mjs: самоподписанные
# ключи, сгенерированные только для проверки конфигов ядром в CI.
client
dev tun
proto udp
remote vpn1.example.net 1194
remote vpn2.example.net 443 tcp
remote-random
cipher AES-256-GCM
data-ciphers AES-256-GCM:CHACHA20-POLY1305
auth SHA256
remote-cert-tls server
verify-x509-name vpn.example.net name
tls-version-min 1.2
auth-user-pass
compress stub-v2
mssfix 1400
nobind
persist-key
persist-tun
verb 3
